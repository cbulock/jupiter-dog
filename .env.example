# Copy to .env locally. Never commit real values.
NETLIFY_SITE_ID=
NETLIFY_ACCESS_TOKEN=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=

# Generate these with npm run admin:password.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
PHOTO_WORKER_SECRET=
# Exact browser origin, without a path. For netlify dev use http://localhost:8888.
ADMIN_ORIGIN=https://jupiter.dog
# Optional: override the origin used for internal function dispatch.
# PHOTO_FUNCTIONS_ORIGIN=http://localhost:8888
# Optional: isolate all photo stores for testing. Production default is jupiter.
# PHOTO_STORE_PREFIX=jupiter-preview
# Explicit offline gallery fixture (development only).
# PHOTO_CATALOG_MODE=fixture
